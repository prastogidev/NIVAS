# NIVAS Backend Environment Configuration Template
# Copy this file to backend/.env and fill in valid API keys for production

ENVIRONMENT=development
LOG_LEVEL=INFO

# External API Keys
OPENWEATHER_API_KEY=your_openweather_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# AQICN live-air-quality token. Never use AQICN's demo token in this field.
AQICN_TOKEN=your_aqicn_token_here
PROPSTACK_API_KEY=your_propstack_api_key_here

# Model Checkpoints & Data Paths
MODEL_CHECKPOINT_DIR=models/checkpoints
DATA_CACHE_DIR=data/cached_demo_data
