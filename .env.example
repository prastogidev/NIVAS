# NIVAS Backend Environment Configuration Template
# Copy this file to backend/.env and populate API keys as needed.
# All external keys are optional; NIVAS runs with deterministic fallbacks when unset.

ENVIRONMENT=development
LOG_LEVEL=INFO

# ==============================================================================
# Generative AI & Neighborhood Advisor (Optional)
# ==============================================================================
# Google Gemini API key: enables live generative responses in Neighborhood AI Advisor.
# Obtain at: https://aistudio.google.com/app/apikey
# Fallback: Rule-based verified telemetry advisor tagged [AI Provider Not Configured].
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API key (secondary generative fallback if Gemini unset).
# Obtain at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# Open Government Data (OGD) Platform India (Optional)
# ==============================================================================
# OGD India API key for optional automated synchronization of official open datasets.
# Obtain at: https://www.data.gov.in/ (Developer Portal: https://api.data.gov.in/)
# Fallback: Verified local historical baseline datasets under backend/data/crime/.
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# ==============================================================================
# Air Quality Index (AQI) Telemetry (Optional)
# ==============================================================================
# OpenWeather Air Pollution API (Primary source, 1-5 native scale).
# Obtain at: https://openweathermap.org/api/air-pollution
# Fallback: AQICN if configured, else reports status='provider_not_configured'.
OPENWEATHER_API_KEY=your_openweather_api_key_here

# AQICN / WAQI API Token (Secondary source, 0-500 scale).
# Obtain at: https://aqicn.org/data-platform/token/
AQICN_TOKEN=your_aqicn_token_here

# ==============================================================================
# Property Valuation Benchmark (Optional)
# ==============================================================================
# Commercial Propstack API key for live transaction benchmarks.
# Fallback: Delhi MCD official circle rate categories (A-H) and cached local benchmarks.
PROPSTACK_API_KEY=your_propstack_api_key_here

# Optional Google Maps Geocoding / Static Maps key (if substituted for Nominatim)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ==============================================================================
# Local Paths & Checkpoints
# ==============================================================================
MODEL_CHECKPOINT_DIR=models/checkpoints
DATA_CACHE_DIR=data/cached_demo_data
